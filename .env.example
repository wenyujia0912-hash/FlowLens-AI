# FlowLens AI 环境变量配置示例
# 复制本文件为 .env 并按需修改；.env 不会被提交到版本库（见 .gitignore）。
# 不得在本文件或任何提交到仓库的文件中填写真实密钥（技术方案 §8）。

# 运行环境：local（本地开发）/ cloud（云端 Demo，云端部署阶段启用）
APP_ENV=local

# 应用名称，用于页面标题展示
APP_NAME=FlowLens AI

# SQLite 数据库文件路径（相对路径相对于项目根目录）
DATABASE_PATH=database/flowlens.db

# AI 服务模式：mock（默认，不调用真实大模型）/ real
AI_MODE=mock

# 真实大模型 API Key（仅 AI_MODE=real 时需要；留空即可运行 Mock 模式）
AI_API_KEY=

# 是否为 Demo 模式（云端部署阶段启用，影响"恢复初始数据"等入口展示）
DEMO_MODE=false
